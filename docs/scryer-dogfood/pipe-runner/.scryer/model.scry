    {
      "id": "pipe-runner-app",
      "type": "c4",
      "position": { "x": 80, "y": 40 },
      "data": {
        "name": "Pipe Runner App",
        "description": "Dogfood React platform game used to verify Scryer diagram modeling and live review.",
        "kind": "system",
        "status": "implemented",
        "sources": [
          {
            "pattern": "src/**/*.tsx",
            "comment": "React page and canvas component"
          },
          {
            "pattern": "src/game/**/*.ts",
            "comment": "Game rules, level data, physics, rendering, and shared types"
          }
        ],
        "contract": {
          "expect": [
            "Game can be played by keyboard through the visible canvas.",
            "HUD exposes status, score, lives, and collected coins for live verification.",
            "Diagrams are linked to real source files and behavior flows."
          ],
          "ask": [],
          "never": [
            "Do not persist renderer output or render-cache metadata in .scry."
          ]
        }
      }
    },
