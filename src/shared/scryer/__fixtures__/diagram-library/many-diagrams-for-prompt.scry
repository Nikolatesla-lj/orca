    {
      "id": "diagram-18-c4-context",
      "name": "C4 Context",
      "kind": "c4",
      "notation": "mermaid",
      "description": "Context diagram for platform",
      "tags": ["c4"],
      "source": "C4Context\n  Person(user, \"User\")\n  System(system, \"Platform\")\n  Rel(user, system, \"Uses\")"
    },
    {
      "id": "diagram-19-refund-flow",
      "name": "Refund Flow",
      "kind": "flowchart",
      "notation": "mermaid",
      "description": "Refund handling flow",
      "tags": ["payment", "refund"],
