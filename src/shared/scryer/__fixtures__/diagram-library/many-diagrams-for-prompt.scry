      "name": "Network Packet",
      "kind": "packet",
      "notation": "mermaid",
      "description": "Packet payload layout",
      "tags": ["network"],
      "source": "packet-beta\n  0-7: \"Version\"\n  8-15: \"Type\"\n  16-31: \"Length\""
    },
    {
      "id": "diagram-17-team-kanban",
      "name": "Team Kanban",
      "kind": "kanban",
      "notation": "mermaid",
      "description": "Team work board",
      "tags": ["team"],
      "source": "kanban\n  Todo\n    Task A\n  Doing\n    Task B\n  Done\n    Task C"
