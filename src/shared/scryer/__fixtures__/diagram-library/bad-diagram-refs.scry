    {
      "id": "flow-1",
      "name": "Checkout",
      "steps": [
        {
          "id": "step-root",
          "description": "Root step",
          "branches": [
            {
              "condition": "if approved",
              "steps": [
                {
                  "id": "step-nested",
                  "description": "Nested step"
                }
              ]
            }
          ]
        }
      ]
    }
